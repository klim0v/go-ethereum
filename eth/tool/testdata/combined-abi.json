  "sources": {
    "contracts/MockAttestation.sol": {
      "content": "pragma solidity ^0.8.0;\n\ncontract MockAttestation {\n\n    mapping(bytes32 => bool) internal isNodeIDAttested;\n\n    function publishNodeIDAttestation(bytes32 _hash) external {\n        isNodeIDAttested[_hash] = true;\n    }\n\n    function verifyNodeIDAttestation(bytes32 _hash) external view returns(bool) {\n        return isNodeIDAttested[_hash];\n    }\n\n    // just in case ?\n    function recallNodeIDAttestation(bytes32 _hash) external {\n        isNodeIDAttested[_hash] = false;\n    }\n\n}\n",
      "urls": []
    },
    "contracts/MockState.sol": {
      "content": "pragma solidity ^0.8.0;\n\nimport \"@openzeppelin/contracts/utils/Create2.sol\";\n\ncontract MockState {\n\n        // Errors\n\n        error EthSendFailed(address to, uint256 value);\n\n        error ForwardCallFailed(bytes res);\n\n        // Events\n\n        event Fallback();\n\n        event Received();\n\n        event StateVarAChanged(bytes32 val);\n\n        event StateVarBChanged(bytes32 val);\n\n        event EthSent(uint256 val, address to);\n\n        // State Variables\n\n        bytes32 internal stateVarA;\n\n        bytes32 internal stateVarB;\n\n        // Constructor\n\n        constructor(bytes32 _stateVarA, bytes32 _stateVarB, address payable destroyBeneficiary) payable {\n                stateVarA = _stateVarA;\n                stateVarB = _stateVarB;\n                if (destroyBeneficiary != address(0x0)) {\n                        selfdestruct(destroyBeneficiary);\n                }\n        }\n\n        // Fallback\n\n        receive() payable external {\n                emit Received();\n        }\n\n        fallback() external {\n                emit Fallback();\n        }\n\n        // General Functions\n\n        function writeStateVarA(bytes32 val) external {\n                stateVarA = val;\n                emit StateVarAChanged(val);\n        }\n\n        function writeStateVarB(bytes32 val) external {\n                stateVarB = val;\n                emit StateVarBChanged(val);\n        }\n\n        function destroySelf(address payable addr) external {\n                selfdestruct(addr);\n        }\n\n        function sendEth(uint256 value, address payable to) external payable {\n                (bool success, ) = to.call{value: value}(new bytes(0));\n                if (!success) {\n                    revert EthSendFailed(to, value);\n                }\n                emit EthSent(value, to);\n        }\n\n        function forwardCall(address payable target, uint256 val, bytes calldata data) external returns(bytes memory) {\n                (bool success, bytes memory res) = target.call{value: val}(data);\n                if (!success) {\n                        revert ForwardCallFailed(res);\n                }\n                return res;\n        }\n\n//        function getBytecode(bytes32 _stateVarA, bytes32 _stateVarB) external pure returns (bytes memory) {\n//                bytes memory bytecode = type(MockState).creationCode;\n//                return abi.encodePacked(bytecode, abi.encode(_stateVarA, _stateVarB));\n//        }\n\n        /**\n        * @dev Deploys a contract using `CREATE2`. The address where the contract\n        * will be deployed can be known in advance via {computeAddress}.\n        *\n        * The bytecode for a contract can be obtained from Solidity with\n        * `type(contractName).creationCode`.\n        *\n        * Requirements:\n        *\n        * - `bytecode` must not be empty.\n        * - `salt` must have not been used for `bytecode` already.\n        * - the factory must have a balance of at least `amount`.\n        * - if `amount` is non-zero, `bytecode` must have a `payable` constructor.\n        * https://github.com/OpenZeppelin/openzeppelin-contracts/blob/master/contracts/utils/Create2.sol\n        */\n        function deploy(uint256 amount, bytes32 salt, bytes memory bytecode) external returns (address) {\n                return Create2.deploy(amount, salt, bytecode);\n        }\n\n}\n",
      "urls": []
    }
  }
